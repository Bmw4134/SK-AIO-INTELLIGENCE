{
  "name": "sk-aio-intelligence",
  "displayName": "SK-AIO Intelligence",
  "description": "A unified orchestration layer combining the Infinity Singularity Kernel with Perplexity-enhanced AI agents",
  "version": "0.1.0",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "sk-aio-intelligence.showLangGraphView",
        "title": "Show LangGraph View"
      }
    ]
  },
  "scripts": {
    "dev": "webpack serve --config webpack.app.config.js",
    "build": "webpack --config webpack.app.config.js --mode production",
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:report": "playwright show-report",
    "test:ai": "playwright test tests/ai-tester.spec.ts",
    "test:api": "playwright test tests/api-integration.spec.ts",
    "test:mobile": "playwright test --grep 'Mobile Testing'",
    "test:cross-browser": "playwright test --grep 'Cross-browser Testing'",
    "test:critical": "playwright test --grep 'should load and display all main UI components|should test complete user workflow'",
    "test:performance": "playwright test --grep 'performance'",
    "test:accessibility": "playwright test --grep 'accessibility'",
    "install-browsers": "playwright install"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.1",
    "@types/glob": "^8.1.0",
    "@types/mocha": "^10.0.1",
    "@types/node": "^16.18.126",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@types/vscode": "^1.80.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vscode/test-electron": "^2.3.4",
    "autoprefixer": "^10.4.21",
    "css-loader": "^6.11.0",
    "eslint": "^8.44.0",
    "glob": "^10.3.3",
    "html-webpack-plugin": "^5.6.3",
    "mini-css-extract-plugin": "^2.9.2",
    "mocha": "^10.2.0",
    "playwright": "^1.54.1",
    "postcss-loader": "^8.1.1",
    "style-loader": "^3.3.3",
    "tailwindcss": "^4.1.11",
    "ts-loader": "^9.4.4",
    "typescript": "^5.1.6",
    "webpack": "^5.88.2",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.2.2"
  },
  "dependencies": {
    "@types/axios": "^0.9.36",
    "@vscode/webview-ui-toolkit": "^1.2.2",
    "@xyflow/react": "^12.8.2",
    "axios": "^1.10.0",
    "dotenv-webpack": "^8.1.1",
    "postcss": "^8.5.6",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "zustand": "^5.0.6"
  }
}
